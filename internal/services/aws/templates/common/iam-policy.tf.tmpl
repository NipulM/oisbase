resource "aws_iam_policy" "{{ .policy_name }}" {
  name        = "${var.app_name}-{{ .policy_name }}-${var.environment}"
  description = "IAM policy for {{ .source_instance }} to access {{ .target_service }}"

  policy = jsonencode({
    Version = "2012-10-17"
    Statement = [
{{- range .statements }}
      {
        Effect = "Allow"
        Action = {{ .Actions | toJson }}
        Resource = {{ .Resources | toJson }}
      }{{ if not .Last }},{{ end }}
{{- end }}
    ]
  })
}

resource "aws_iam_role_policy_attachment" "{{ .policy_name }}_attachment" {
  role       = aws_iam_role.{{ .role_name }}.name
  policy_arn = aws_iam_policy.{{ .policy_name }}.arn
}